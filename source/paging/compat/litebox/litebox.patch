+pub(crate) fn effective_flags(root: PhysAddr, address: usize) -> PageTableFlags {
+    use x86_64::structures::paging::PageTable;
+
+    let access =
+        PageTableFlags::PRESENT | PageTableFlags::WRITABLE | PageTableFlags::USER_ACCESSIBLE;
+    let mut effective = access;
+    let mut table = root;
+    for level in (0..4).rev() {
+        let entries = unsafe { &*MockKernel::pa_to_va(table).as_ptr::<PageTable>() };
+        let entry = &entries[(address >> (12 + level * 9)) & 511];
+        let flags = entry.flags();
+        assert!(flags.contains(PageTableFlags::PRESENT));
+        effective &= flags | !access;
+        effective |= flags & PageTableFlags::NO_EXECUTE;
+        if level == 0 || flags.contains(PageTableFlags::HUGE_PAGE) {
+            return effective;
+        }
+        table = entry.addr();
+    }
+    unreachable!()
+}

+#[test]
+fn test_boot_rejects_restrictive_user_parent_without_changing_it() {
+    extern crate std;
+    use core::sync::atomic::{AtomicU64, Ordering};
+
+    let root = test_root().start_address();
+    let range = PageRange::new(0x80_0000, 0x80_1000).unwrap();
+    let table = unsafe { X64PageTable::<MockKernel, PAGE_SIZE>::init(root) };
+    table.map_pages(range, VmFlags::VM_READ | VmFlags::VM_EXEC, true);
+    drop(table);
+    let slot = unsafe { AtomicU64::from_ptr(MockKernel::pa_to_va(root).as_mut_ptr::<u64>()) };
+    let original = slot.load(Ordering::Acquire);
+    let restricted = original | PageTableFlags::NO_EXECUTE.bits();
+    slot.store(restricted, Ordering::Release);
+    let result =
+        std::panic::catch_unwind(|| unsafe { X64PageTable::<MockKernel, PAGE_SIZE>::init(root) });
+    assert!(result.is_err());
+    assert_eq!(slot.load(Ordering::Acquire), restricted);
+    assert!(effective_flags(root, range.start).contains(PageTableFlags::NO_EXECUTE));
+    slot.store(original, Ordering::Release);
+    let table = unsafe { X64PageTable::<MockKernel, PAGE_SIZE>::init(root) };
+    unsafe { table.unmap_pages(range, true) }.unwrap();
+}

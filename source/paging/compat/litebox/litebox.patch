+#[test]
+fn test_permissions_are_leaf_local_after_creation_and_relocation() {
+    let root = test_root().start_address();
+    let table = unsafe { X64PageTable::<MockKernel, PAGE_SIZE>::init(root) };
+    let read_only = PageRange::new(0x70_0000, 0x70_1000).unwrap();
+    let writable = PageRange::new(0x70_1000, 0x70_2000).unwrap();
+    let rwx = VmFlags::VM_READ | VmFlags::VM_WRITE | VmFlags::VM_EXEC;
+    table.map_pages(read_only, VmFlags::VM_READ, true);
+    table.map_pages(writable, rwx, true);
+    let expected_read =
+        PageTableFlags::PRESENT | PageTableFlags::USER_ACCESSIBLE | PageTableFlags::NO_EXECUTE;
+    let expected_rwx =
+        PageTableFlags::PRESENT | PageTableFlags::USER_ACCESSIBLE | PageTableFlags::WRITABLE;
+    assert_eq!(effective_flags(root, read_only.start), expected_read);
+    assert_eq!(effective_flags(root, writable.start), expected_rwx);
+
+    let start = (1usize << 39) + PAGE_SIZE;
+    let relocated = PageRange::new(start, start + PAGE_SIZE).unwrap();
+    let sibling = PageRange::new(start + PAGE_SIZE, start + 2 * PAGE_SIZE).unwrap();
+    unsafe { table.remap_pages(read_only, relocated) }.unwrap();
+    table.map_pages(sibling, rwx, true);
+    assert_eq!(effective_flags(root, relocated.start), expected_read);
+    assert_eq!(effective_flags(root, sibling.start), expected_rwx);
+    unsafe { table.mprotect_pages(relocated, VmFlags::VM_READ | VmFlags::VM_EXEC) }.unwrap();
+    assert_eq!(
+        effective_flags(root, relocated.start),
+        PageTableFlags::PRESENT | PageTableFlags::USER_ACCESSIBLE
+    );
+    for range in [writable, relocated, sibling] {
+        unsafe { table.unmap_pages(range, true) }.unwrap();
+    }
+}

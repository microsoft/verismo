+pub(crate) fn test_root() -> PhysFrame<Size4KiB> {
+    #[cfg(feature = "verismo-paging")]
+    {
+        // Register a bounded future table-page pool before constructing the mock direct map.
+        let reserve = MockKernel::mem_allocate_pages(6).unwrap();
+        unsafe { MockKernel::mem_free_pages(reserve, 6) };
+    }
+    let root = PageTableAllocator::<MockKernel>::allocate_frame(true).unwrap();
+    #[cfg(feature = "verismo-paging")]
+    seed_table_mappings(root);
+    root
+}
+
+#[cfg(feature = "verismo-paging")]
+fn seed_table_mappings(root: PhysFrame<Size4KiB>) {
+    use x86_64::structures::paging::{
+        FrameAllocator, MappedPageTable, Mapper, PageTable,
+        mapper::{MapToError, PageTableFrameMapping},
+    };
+
+    struct Mapping;
+    unsafe impl PageTableFrameMapping for Mapping {
+        fn frame_to_pointer(&self, frame: PhysFrame) -> *mut PageTable {
+            MockKernel::pa_to_va(frame.start_address()).as_mut_ptr()
+        }
+    }
+    struct Allocator;
+    unsafe impl FrameAllocator<Size4KiB> for Allocator {
+        fn allocate_frame(&mut self) -> Option<PhysFrame<Size4KiB>> {
+            PageTableAllocator::<MockKernel>::allocate_frame(true)
+        }
+    }
+
+    let root =
+        unsafe { &mut *MockKernel::pa_to_va(root.start_address()).as_mut_ptr::<PageTable>() };
+    let mut mapper = unsafe { MappedPageTable::new(root, Mapping) };
+    let mut mapped = 0;
+    loop {
+        let addresses = MAPPING.lock().as_slice().to_vec();
+        for (index, address) in addresses.iter().enumerate().skip(mapped) {
+            let frame = PhysFrame::from_start_address(PhysAddr::new(
+                (0x1000_0000 + index * PAGE_SIZE) as u64,
+            ))
+            .unwrap();
+            let result = unsafe {
+                mapper.map_to_with_table_flags(
+                    Page::<Size4KiB>::from_start_address(*address).unwrap(),
+                    frame,
+                    PageTableFlags::PRESENT | PageTableFlags::WRITABLE | PageTableFlags::NO_EXECUTE,
+                    super::pgtable::USER_PARENT_FLAGS,
+                    &mut Allocator,
+                )
+            };
+            match result {
+                Ok(flush) => flush.ignore(),
+                Err(MapToError::PageAlreadyMapped(_)) => {
+                    panic!("duplicate mock direct-map address")
+                }
+                Err(error) => panic!("cannot seed mock direct map: {error:?}"),
+            }
+        }
+        mapped = addresses.len();
+        if MAPPING.lock().len() == mapped {
+            break;
+        }
+    }
+}

-use litebox::mm::linux::PageFaultError;
+use core::sync::atomic::{AtomicU64, Ordering};
+use litebox::mm::linux::{PageFaultError, PageRange};

 use crate::arch::{
     Page, PageFaultErrorCode, PageSize, PageTableFlags, PhysAddr, PhysFrame, Size4KiB, VirtAddr,
 };

+pub(crate) const USER_ADDRESS_END: usize = 1 << 47;
+pub(crate) const USER_PARENT_FLAGS: PageTableFlags = PageTableFlags::from_bits_retain(
+    PageTableFlags::PRESENT.bits()
+        | PageTableFlags::WRITABLE.bits()
+        | PageTableFlags::USER_ACCESSIBLE.bits()
+        | PageTableFlags::ACCESSED.bits()
+        | PageTableFlags::DIRTY.bits(),
+);
+
+pub(crate) fn assert_user_range<const ALIGN: usize>(range: PageRange<ALIGN>) {
+    assert!(
+        range.start < USER_ADDRESS_END && range.end <= USER_ADDRESS_END,
+        "page-table operations require a user-half range"
+    );
+}
+
+/// # Safety
+/// The correctly leveled, acyclic tree must be accessible through `M`, with
+/// software mutation excluded during validation. Hardware may update A/D bits.
+pub(crate) unsafe fn validate_user_parents<M: super::MemoryProvider>(
+    root: PhysAddr,
+) -> Result<(), (PhysAddr, usize, PageTableFlags)> {
+    unsafe fn visit<M: super::MemoryProvider>(
+        table: PhysAddr,
+        level: usize,
+        count: usize,
+    ) -> Result<(), (PhysAddr, usize, PageTableFlags)> {
+        if level == 0 {
+            return Ok(());
+        }
+        let words = M::pa_to_va(table).as_mut_ptr::<u64>();
+        for index in 0..count {
+            let bits = unsafe { AtomicU64::from_ptr(words.add(index)) }.load(Ordering::Acquire);
+            let flags = PageTableFlags::from_bits_retain(bits);
+            if !flags.contains(PageTableFlags::PRESENT) || flags.contains(PageTableFlags::HUGE_PAGE)
+            {
+                continue;
+            }
+            if !flags.contains(PageTableFlags::WRITABLE | PageTableFlags::USER_ACCESSIBLE)
+                || flags.contains(PageTableFlags::NO_EXECUTE)
+            {
+                return Err((table, index, PageTableFlags::from_bits_truncate(bits)));
+            }
+            let child = PhysAddr::new(bits & 0x000f_ffff_ffff_f000 & !M::PRIVATE_PTE_MASK);
+            unsafe { visit::<M>(child, level - 1, 512) }?;
+        }
+        Ok(())
+    }
+
+    unsafe { visit::<M>(root, 3, 256) }
+}
